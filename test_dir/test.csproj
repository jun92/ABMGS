<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <Target Name="FlatcGenerate" BeforeTargets="BeforeCompile">
    <Message Text="Generating code..." Importance="high" />
    <MakeDir Directories="./generated" />
    <Exec Command="echo 'namespace SyncnetPlatform.Protocols { public class Test { } }' > ./generated/Test.cs" />
    <!-- Notice we are adding it to Compile dynamically -->
    <ItemGroup>
      <Compile Include="./generated/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
