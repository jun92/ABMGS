include "Custom.fbs";

namespace ABMGS.ServerV2.SyncnetPlatform.Protocos.FlatBuffer.Generated;


union SystemPacket {
    Dummy,
    Ping,
    Pong,
    LoginRequest,
    MoveRequest
}



table PacketWrapper {
    system_packet: SystemPacket;
    custom_packet: CustomPacket;
}

table Dummy {
    id: int;
}

table Ping {
    seq: int;
}
table Pong {
    seq: int;
}

table LoginRequest {
    id: string;
    from: string;
    count: int;
}

table MoveRequest {
    id: string;
    x: float;
    y: float;
}

root_type PacketWrapper;
