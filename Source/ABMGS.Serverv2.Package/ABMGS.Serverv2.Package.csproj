<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SyncnetPlatform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.15.0" />
    
    <PackageReference Include="Microsoft.Orleans.Clustering.Redis" Version="9.2.1" />
    <PackageReference Include="Microsoft.Orleans.Server" Version="9.2.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Authentication\Guest\" />
    <Folder Include="Migrations\" />
  </ItemGroup>
  
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
        <PropertyGroup>
            <FlatcTool Condition="$([MSBuild]::IsOSPlatform('OSX'))">./flatc</FlatcTool>
            <FlatcTool Condition="$([MSBuild]::IsOSPlatform('Windows'))">flatc.exe</FlatcTool>
        </PropertyGroup>
        <Message Text="Skipping FlatBuffers generation: No flatc binary found for this OS (Linux/Other). Ensure generated files are up to date." Importance="high" Condition="'$(FlatcTool)' == ''" />
		<Exec Command="$(FlatcTool) -n -o ./generated ./fbs/System.fbs" Condition="'$(FlatcTool)' != ''" />
		<Exec Command="$(FlatcTool) -n -o ./generated ./fbs/Player.fbs" Condition="'$(FlatcTool)' != ''" />
		<Exec Command="$(FlatcTool) -n -o ./generated ./fbs/Custom.fbs" Condition="'$(FlatcTool)' != ''" />
	</Target>

</Project>
