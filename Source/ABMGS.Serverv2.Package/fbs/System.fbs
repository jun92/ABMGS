include "Custom.fbs";
include "Player.fbs";

namespace SyncnetPlatform.Protocols.Generated;




union SystemPacket {
    Ping,
    Pong,
    ReqCreateNewUser,
    ResCreateNewUser,
    ReqUserInfo,
    ResUserInfo
}

table PacketWrapper {
    system_packet: SystemPacket;
    custom_packet: CustomPacket;
}


table Ping {
    seq: int;
}
table Pong {
    seq: int;
}


root_type PacketWrapper;
