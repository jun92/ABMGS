

table PlayerCustomData{
	custom_level: int;
	custom_exp: long;
}

union ActionParameters {
	ActionGainExp
}

table ActionGainExp{
	exp: long;
}


table ActionParamtersPacket{
	packet: ActionParameters;
}


table PlayRoomCreationMetaData {
	ext_field1: int;
	ext_field2: string;
	ext_field3: bool;
}