

include "Custom.fbs";
include "Player.fbs";
include "Playroom.fbs";

namespace SyncnetPlatform.Protocols.Generated;


union SystemPacket {
    Ping,
    Pong,
    ReqUserInfo,
    ResUserInfo,
    ReqUserActionForUpdatePlayerCustomData,
    ResUserActionForUpdatePlayerCustomData,
    ReqDirectDeliveryData,
    ResDirectDeliveryData,
    OnDirectDeliveryData,
    ReqCreateRoom,
    ResCreateRoom,
    ReqJoinRoom,
    ResJoinRoom,
    OnPlayerJoinRoom,
    ReqPlayerListInRoom,
    ResPlayerListInRoom,
    ReqLeaveRoom,
    ResLeaveRoom,
    OnPlayerLeaveRoom,
    ReqBroadcastRoom,
    ResBroadcastRoom,
    BroadcastRoom,
    ReqUpdatePlayerName,
    ResUpdatePlayerName,
    DeliverCustomPacket
}

table PacketWrapper {
    system_packet: SystemPacket;
    custom_packet: CustomPacket;
}


table Ping {
    seq: int;
}
table Pong {
    seq: int;
}


root_type PacketWrapper;
