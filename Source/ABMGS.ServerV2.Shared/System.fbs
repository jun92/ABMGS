include "Custom.fbs";

namespace SyncnetPlatform.Protocols.Generated;

union SystemPacket {
    Ping,
    Pong,
    ReqUserInfo,
    ResUserInfo
}

table PacketWrapper {
    system_packet: SystemPacket;
    custom_packet: CustomPacket;
}


table Ping {
    seq: int;
}
table Pong {
    seq: int;
}

table ReqUserInfo {
    
}

table ResUserInfo {
    player_id: [ubyte:16]; //Guid compatible
    player_name: string;
    level :int;
    exp: ulong;
}

root_type PacketWrapper;
